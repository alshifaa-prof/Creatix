# Supabase Public Keys (safe to expose in client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side Edge Function secrets (Set in Supabase Dashboard / CLI secrets, NEVER with VITE_)
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ (or OpenAI default)
# OPENAI_MODEL=gemini-2.5-flash (or gpt-4o-mini)
